.coverage
htmlcov/

# Environment / secrets
.env
.env.local

# Firecrawl search cache
.firecrawl/

# Data — too large to track; reproduce via acquisition scripts
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated outputs (one rule: ignore everything in outputs/ except the
# two .gitkeep files that anchor the figures/ and tables/ subdirs)
outputs/
!outputs/figures/
!outputs/figures/.gitkeep
!outputs/tables/
!outputs/tables/.gitkeep

# Exploratory / alternative-window analysis outputs (regeneratable from
# the panel + analysis module with different filter parameters)
outputs_*/

# Run logs from long pulls/analyses (backfill launcher writes here)
logs/
